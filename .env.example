PORT=3000

# URL /exec del Apps Script "Página Mantenciones"
MANTENCIONES_SCRIPT_URL=

# SECRETO que salió al correr configurar() en el Apps Script
MANTENCIONES_SECRETO=

# Usuarios de la página, separados por coma: usuario:clave
USUARIOS=claudia:cambiar-esta-clave,pablo:cambiar-esta-clave

# Usuarios que pueden eliminar centros, separados por coma
ADMINS=claudia

# Texto largo al azar para firmar las sesiones (cualquier cosa larga sirve)
SESION_SECRETO=
